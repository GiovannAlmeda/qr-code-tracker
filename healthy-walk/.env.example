# ─────────────────────────────────────────────────────────────
# Healthy Walk configuration
# Copy this file to `.env` and fill in what you have.
# The app runs in DEMO MODE with no keys at all, so you can
# look at it before you spend a cent.
# ─────────────────────────────────────────────────────────────

# Google Maps Platform key.
# Enables: real nearby restaurants, ratings, photos, walking times.
# Console: https://console.cloud.google.com/google/maps-apis/credentials
GOOGLE_MAPS_API_KEY=

# Anthropic API key.
# Enables: reading actual restaurant menus and estimating macros.
# Console: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional overrides
PORT=8787
# claude-opus-5 (best) | claude-sonnet-5 (cheaper) | claude-haiku-4-5 (cheapest)
HW_MODEL=claude-opus-5
# Max restaurants whose menus get read per search. This is the main cost
# dial: each one is a separate AI call with web searches inside it.
#   6 on Opus 5  ~= $1.25 a search
#   6 on Sonnet 5 ~= $0.62 a search
HW_MAX_RESTAURANTS=6
# Cache menu analyses for this many hours (cuts repeat cost to zero)
HW_CACHE_HOURS=72
# low | medium | high | xhigh | max — reasoning depth per menu lookup
HW_EFFORT=medium

# Hard monthly ceiling on API spend, in US dollars. The app refuses to
# start a search that would cross it. Set to "off" for no cap.
HW_MONTHLY_BUDGET_USD=25
